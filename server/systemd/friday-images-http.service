# Serves the satellite images read-only on the LAN. The Raspberry Pi Imager manifest (the .json next to the images, on
# the Samba share media\friday\imagens) points at http://<VM>:8088/<image>.img.xz; without this server the owner cannot
# write a card, and writing the bare .img makes the Imager skip Wi-Fi/user/hostname (no cloud-init customization).
# http.server only answers GET/HEAD: read-only, but it is a network-facing parser, so it is confined (final review of
# 2026-11-17, I3):
#  - It stays root: the CIFS mount of the HAOS share is root-only (0700/0600), so DynamicUser/User= could not read it.
#    Instead it loses every capability, its filesystem is read-only, and the other HAOS mounts (secrets.yaml lives in
#    /mnt/haos/config) and /srv/friday are invisible to it.
#  - Bind: the unit cannot know the VM's LAN address, so images_http.py binds to the default-route address (or
#    FRIDAY_IMAGES_BIND) instead of every interface (Docker bridges, IPv6) - and refuses to start without one.
# Plan 2026-11-17-diagnostic-sensors, Task 12.
[Unit]
Description=F.R.I.D.A.Y. - satellite images over HTTP (read-only, LAN)
RequiresMountsFor=/mnt/haos/media/friday/imagens
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/friday/images/images_http.py 8088 /mnt/haos/media/friday/imagens
Restart=always
RestartSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/mnt/haos/media/friday/imagens
InaccessiblePaths=-/mnt/haos/config -/mnt/haos/share -/srv/friday -/root -/etc/friday
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M

[Install]
WantedBy=multi-user.target
