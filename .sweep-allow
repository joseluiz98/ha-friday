# Path-scoped exceptions for scripts/sweep.py: <path-glob>:<regex on the line>. Every line says why.
# Translation/strings texts that describe a token field (not a token).
*/custom_components/friday/strings.json:"token"\s*:\s*"
*/custom_components/friday/translations/*.json:"token"\s*:\s*"
# Redaction code and its docs: the patterns themselves.
*/friday_agent_core/diagnostics.py:PVEAPIToken|Bearer
*/custom_components/friday/redact.py:PVEAPIToken|Bearer
*/custom_components/friday/proxmox.py:PVEAPIToken=\{
*/docs/protocol.md:PVEAPIToken
# The scanner and the sweep define the patterns they look for.
*/scripts/inventory_scan.py:.
*/scripts/sweep.py:.
# Test fixtures with fake values.
*/tests/*:hunter2|s3cr3t|pw-secret|legacy-pw|abc\.def-123|SflKxwRJ|uuid-1|PVEAPIToken=ha@pve!friday-reboot=s3cr3t
*/test_essentials_backup.sh:SEGREDO_
# The author's name in the license (authorship, public on purpose).
private:*/LICENSE:^Copyright
# This file names the patterns it allows.
*/.sweep-allow:.
# The GitHub account in URLs and codeowners (public by nature).
*:joseluiz98
# Fake Telegram bot token in the redaction tests.
*/tests/agents/test_diagnostics.py:bot\d{6,}:
# Fixtures of the scanner/sweep tests: fake values built to match the generic patterns.
*/tests/tools/*:-----BEGIN PRIVATE KEY-----|AIzaB{35}|sk-a{40}|ghp_c{36}|github_pat_d{60}|sk_e{48}|192\.168\.77\.|02:00:5E:|Bearer abcdefghij|eyJhbGciOiJIUzI1NiJ9|PVEAPIToken=ha@pve!x|"token": "Leave blank|/home/zelda
# Fake service-account e-mail in the cost tests.
*/server/cost/test_official.py:svc@x\.iam
# Fake Raspberry Pi MAC in the satellite hardware tests.
*/tests/agents/test_satellite_hardware.py:B8:27:EB:00:00:01
*/tests/tools/test_sweep.py:02\\\\\\\\:00
*/tests/agents/test_satellite_hardware.py:B8\\\\:27\\\\:EB\\\\:00
# Placeholder MAC that the history rewrite puts where a real one was.
*:02(\\*:)00(\\*:)00(\\*:)00(\\*:)00(\\*:)00|02:00:00:00:00:00
# The PVE auth header is built from config in the server agent (format string, no token).
*/agents/server/friday_server_agent/__main__.py:PVEAPIToken=
