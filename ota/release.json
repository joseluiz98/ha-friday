{
  "schema": 1,
  "protocol": {"satellite": 1, "server": 2, "update": 1},
  "min_protocol": {"satellite": 1},
  "requires": {"satellite": {"server": 2}},
  "heavy": ["container"],
  "components": {
    "satellite": ["satellite/program", "satellite/migrations", "satellite/audio", "satellite/sync",
                  "agents/satellite", "agents/common", "vault/manifest.json"],
    "server-agent": ["agents/server", "agents/common", "scripts/vault.py", "vault/manifest.json"],
    "server": ["server/status", "server/essentials", "server/cataloger", "server/cost", "server/aec", "server/asr", "server/browser",
               "server/images", "server/systemd", "server/install.sh", "voice_gateway/local_config.py"],
    "voice-gateway": ["voice_gateway", "scripts/lib"],
    "brain-skills": ["brain"],
    "container": ["server/image"],
    "wwt": ["tools/wakeword/training", "tools/wakeword/wwt"],
    "integration": ["custom_components/friday"]
  },
  "package": {
    "satellite": {
      "paths": [
        "satellite/program",
        "satellite/migrations",
        "satellite/audio",
        "satellite/sync",
        "agents/satellite/friday_satellite_agent",
        "agents/satellite/friday-satellite-agent.service",
        "agents/satellite/sudoers.friday-satellite-agent",
        "agents/satellite/friday-agent-apply",
        "agents/satellite/friday-wifi-apply",
        "agents/satellite/friday-ota-apply",
        "agents/satellite/requirements.lock",
        "agents/common/friday_agent_core",
        "vault/manifest.json",
        "ota/release.json"
      ],
      "system": [
        "satellite/program",
        "satellite/sync",
        "satellite/audio/jabra.conf",
        "satellite/audio/xvf3800.conf",
        "satellite/audio/friday-audio-select",
        "satellite/audio/90-friday-audio.rules",
        "satellite/audio/audio-board.conf",
        "satellite/audio/friday-silence.service",
        "agents/satellite/friday-satellite-agent.service",
        "agents/satellite/sudoers.friday-satellite-agent",
        "agents/satellite/friday-agent-apply",
        "agents/satellite/friday-wifi-apply",
        "agents/satellite/friday-ota-apply"
      ]
    }
  }
}
