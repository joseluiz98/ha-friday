[Unit]
Description=F.R.I.D.A.Y. satellite first boot (identity only)
ConditionPathExists=!/etc/friday-satelite/.firstboot-done
Before=friday-satelite.service friday-satellite-agent.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/friday/current/program
ExecStart=/opt/friday/current/venv/bin/python -u /opt/friday/current/program/firstboot.py

[Install]
WantedBy=multi-user.target
