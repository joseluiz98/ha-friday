# Audio board plugged or unplugged (XVF3800 2886:001a, Jabra Speak 410 0b0e:0410): restart the voice program, the
# player and the agent; their ExecCondition (friday-audio-select --check) picks the board again.
ACTION=="add|remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="2886/1a/*|b0e/410/*", RUN+="/bin/systemctl --no-block try-restart friday-satelite.service sendspin-cli.service friday-satellite-agent.service", RUN+="/bin/systemctl --no-block start friday-satelite.service sendspin-cli.service"
